# Local dev — docker-compose root (avoids sha256_password on user `bpr` until you run prisma/mysql-fix-auth.sql).
# For user bpr after fixing auth: mysql://bpr:bpr_secret@127.0.0.1:3306/bpr_ledger?allowPublicKeyRetrieval=true
DATABASE_URL="mysql://root@127.0.0.1:3306/bpr_ledger?allowPublicKeyRetrieval=true"
JWT_SECRET="dev-jwt-secret-change-in-production-min-32-chars-long"
PORT=4001

# Dev only: skip JWT on protected APIs (use with client VITE_BYPASS_AUTH). Set false or remove for real auth.
AUTH_BYPASS=true
