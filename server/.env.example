# Prisma does not support MySQL auth plugin sha256_password. Use mysql_native_password or caching_sha2 (see prisma/mysql-fix-auth.sql).
# Docker Compose (root): mysql://root:root@127.0.0.1:3306/bpr_ledger?allowPublicKeyRetrieval=true
DATABASE_URL="mysql://user:password@localhost:3306/bpr_ledger?allowPublicKeyRetrieval=true"
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=4001

# Optional: set to 1 to keep strict HTTPS when running `npm run db:generate` (default allows Prisma engine download behind SSL-inspecting proxies)
# PRISMA_STRICT_TLS=1

# Dev only: skip JWT on protected routes. Pair with client VITE_BYPASS_AUTH=true. Never use in production.
# AUTH_BYPASS=true
